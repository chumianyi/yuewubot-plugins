{
  "name": "fishing",
  "version": "1.0.0",
  "author": "YueWu",
  "description": "纯文本钓鱼游戏：稀有度鱼种、鱼塘水族箱、装备精炼、商店市场、交易所、抽卡、偷鱼红包、成就称号与 Web 管理后台",
  "homepage": "",
  "repository": "https://github.com/chumianyi/yuewubot-plugins/tree/main/fishing",
  "icon": "icon.png",
  "hooks": {},
  "triggers": {},
  "commands": [
    {
      "name": "钓鱼",
      "aliases": [
        "fish",
        "dg"
      ],
      "description": "下竿钓鱼，可带 2/3 选择钓场",
      "usage": "/钓鱼 [2|3]",
      "handler": "cmd_fish"
    },
    {
      "name": "鱼塘",
      "aliases": [
        "pond",
        "yt"
      ],
      "description": "查看鱼塘里的鱼与总估值",
      "usage": "/鱼塘",
      "handler": "cmd_pond"
    },
    {
      "name": "出售",
      "aliases": [
        "sell"
      ],
      "description": "卖鱼，支持短码、全部、按星级",
      "usage": "/出售 F码 [数量] | 全部 | 星N",
      "handler": "cmd_sell"
    },
    {
      "name": "水族箱",
      "aliases": [
        "tank"
      ],
      "description": "防偷存储空间，可存入取出升级",
      "usage": "/水族箱 查看 | 存入 F码 | 取出 F码 | 升级",
      "handler": "cmd_tank"
    },
    {
      "name": "图鉴",
      "aliases": [
        "book",
        "tj"
      ],
      "description": "查看已解锁鱼种与最大重量",
      "usage": "/图鉴",
      "handler": "cmd_book"
    },
    {
      "name": "背包",
      "aliases": [
        "bag"
      ],
      "description": "查看金币、道具与装备",
      "usage": "/背包",
      "handler": "cmd_bag"
    },
    {
      "name": "鱼竿",
      "aliases": [
        "rod"
      ],
      "description": "鱼竿装备、丢弃、锁定",
      "usage": "/鱼竿 装备 R码",
      "handler": "cmd_rod"
    },
    {
      "name": "饰品",
      "aliases": [
        "acc"
      ],
      "description": "饰品装备、丢弃、锁定",
      "usage": "/饰品 装备 A码",
      "handler": "cmd_acc"
    },
    {
      "name": "商店",
      "aliases": [
        "shop"
      ],
      "description": "查看三家商店与商品",
      "usage": "/商店 [1|2|3]",
      "handler": "cmd_shop"
    },
    {
      "name": "购买",
      "aliases": [
        "buy"
      ],
      "description": "购买商店商品",
      "usage": "/购买 1 3 [数量]",
      "handler": "cmd_buy"
    },
    {
      "name": "精炼",
      "aliases": [
        "refine"
      ],
      "description": "消耗精炼石强化装备",
      "usage": "/精炼 鱼竿 R码",
      "handler": "cmd_refine"
    },
    {
      "name": "排行榜",
      "aliases": [
        "rank",
        "phb"
      ],
      "description": "金币、鱼获、数量、图鉴排行",
      "usage": "/排行榜 [金币|鱼获|数量|图鉴]",
      "handler": "cmd_rank"
    },
    {
      "name": "日常",
      "aliases": [
        "daily"
      ],
      "description": "领取每日补给，连续签到有加成",
      "usage": "/日常",
      "handler": "cmd_daily"
    },
    {
      "name": "市场",
      "aliases": [
        "market"
      ],
      "description": "浏览玩家挂单",
      "usage": "/市场 [页]",
      "handler": "cmd_market"
    },
    {
      "name": "上架",
      "aliases": [
        "list",
        "sj"
      ],
      "description": "把鱼或大宗商品挂到市场",
      "usage": "/上架 F码 价格 [数量] [匿名]",
      "handler": "cmd_list"
    },
    {
      "name": "下架",
      "aliases": [
        "unlist"
      ],
      "description": "撤回自己的挂单",
      "usage": "/下架 M码",
      "handler": "cmd_unlist"
    },
    {
      "name": "收购",
      "aliases": [
        "purchase",
        "sg"
      ],
      "description": "购买市场挂单",
      "usage": "/收购 M码 [数量]",
      "handler": "cmd_purchase"
    },
    {
      "name": "交易所",
      "aliases": [
        "exchange",
        "jys"
      ],
      "description": "大宗商品行情、买入、卖出、历史",
      "usage": "/交易所 状态 | 买入 鱼油 10",
      "handler": "cmd_exchange"
    },
    {
      "name": "持仓",
      "aliases": [
        "holdings"
      ],
      "description": "查看交易所持仓与盈亏",
      "usage": "/持仓",
      "handler": "cmd_holdings"
    },
    {
      "name": "清仓",
      "aliases": [
        "clear"
      ],
      "description": "一键卖出全部持仓",
      "usage": "/清仓",
      "handler": "cmd_clear"
    },
    {
      "name": "抽卡",
      "aliases": [
        "gacha",
        "ck"
      ],
      "description": "单抽或十连，产出道具装备",
      "usage": "/抽卡 [十连]",
      "handler": "cmd_gacha"
    },
    {
      "name": "偷鱼",
      "aliases": [
        "steal"
      ],
      "description": "从别人鱼塘偷一条鱼",
      "usage": "/偷鱼 @某人",
      "handler": "cmd_steal"
    },
    {
      "name": "电鱼",
      "aliases": [
        "zap"
      ],
      "description": "电击对方鱼塘，失败有天罚",
      "usage": "/电鱼 @某人",
      "handler": "cmd_zap"
    },
    {
      "name": "偷看",
      "aliases": [
        "peek"
      ],
      "description": "查看他人鱼塘与档案",
      "usage": "/偷看 @某人",
      "handler": "cmd_peek"
    },
    {
      "name": "成就",
      "aliases": [
        "ach"
      ],
      "description": "查看成就进度",
      "usage": "/成就",
      "handler": "cmd_ach"
    },
    {
      "name": "称号",
      "aliases": [
        "title"
      ],
      "description": "查看或装备称号",
      "usage": "/称号 [编号]",
      "handler": "cmd_title"
    },
    {
      "name": "转账",
      "aliases": [
        "transfer"
      ],
      "description": "向其他玩家转金币",
      "usage": "/转账 QQ 金额",
      "handler": "cmd_transfer"
    },
    {
      "name": "我的",
      "aliases": [
        "profile",
        "my"
      ],
      "description": "查看个人完整档案",
      "usage": "/我的",
      "handler": "cmd_me"
    },
    {
      "name": "红包",
      "aliases": [
        "redpack",
        "hb"
      ],
      "description": "发红包、领红包、查看红包列表",
      "usage": "/红包 发 金额 份数 [口令]",
      "handler": "cmd_redpack"
    },
    {
      "name": "渔助",
      "aliases": [
        "fishhelp"
      ],
      "description": "钓鱼游戏完整指令手册",
      "usage": "/渔助",
      "handler": "cmd_fishhelp"
    },
    {
      "name": "渔管",
      "aliases": [
        "fishadmin"
      ],
      "description": "主人专属管理指令",
      "usage": "/渔管 金币 QQ 数量",
      "handler": "cmd_admin"
    }
  ],
  "config": {
    "owner": {
      "type": "string",
      "label": "主人 QQ（管理权限）",
      "default": "3835347820"
    },
    "daily_limit": {
      "type": "number",
      "label": "每日钓鱼次数",
      "default": 30
    },
    "cooldown": {
      "type": "number",
      "label": "钓鱼冷却秒数",
      "default": 3
    },
    "tax_rate": {
      "type": "number",
      "label": "交易税率",
      "default": 0.05
    },
    "reset_hour": {
      "type": "number",
      "label": "每日重置时间点",
      "default": 4
    },
    "gacha_cost": {
      "type": "number",
      "label": "单抽价格（金币）",
      "default": 2000
    },
    "steal_rate": {
      "type": "number",
      "label": "偷鱼成功率",
      "default": 0.45
    },
    "zap_rate": {
      "type": "number",
      "label": "电鱼成功率",
      "default": 0.35
    },
    "announce": {
      "type": "string",
      "label": "系统公告",
      "default": ""
    }
  }
}
