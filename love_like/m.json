{
  "name": "爱点赞",
  "version": "1.1.0",
  "author": "YueWu",
  "description": "直接发送「赞我」，给发送者点 10 个赞并回复。是否已点过由平台接口的返回结果判定，不再使用本地 24 小时冷却，避免误判",
  "homepage": "",
  "repository": "https://github.com/chumianyi/yuewubot-plugins/tree/main/love_like",
  "icon": "icon.png",
  "hooks": {
    "on_startup": "on_startup",
    "on_message": "on_message"
  },
  "triggers": {
    "on_message": [
      "赞我"
    ]
  },
  "commands": [],
  "config": {
    "times": {
      "type": "number",
      "label": "每次点赞数量",
      "default": 10
    }
  }
}
